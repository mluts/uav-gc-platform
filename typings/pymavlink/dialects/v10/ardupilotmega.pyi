    msgname = ...
    fieldnames = ...
    ordered_fieldnames = ...
    fieldtypes = ...
    fielddisplays_by_name: Dict[str, str] = ...
    fieldenums_by_name: Dict[str, str] = ...
    fieldunits_by_name: Dict[str, str] = ...
    native_format = ...
    orders = ...
    lengths = ...
    array_lengths = ...
    crc_extra = ...
    unpacker = ...
    instance_field = ...
    instance_offset = ...
    def __init__(self, onboard_control_sensors_present: int, onboard_control_sensors_enabled: int, onboard_control_sensors_health: int, load: int, voltage_battery: int, current_battery: int, battery_remaining: int, drop_rate_comm: int, errors_comm: int, errors_count1: int, errors_count2: int, errors_count3: int, errors_count4: int) -> None:
